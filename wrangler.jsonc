{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tezz-lang",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs"
  },
  "routes": [
    {
      "pattern": "tezz.abhinavkumarsingh.tech/*",
      "zone_name": "abhinavkumarsingh.tech"
    }
  ]
}
