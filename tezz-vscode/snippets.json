  "Try-Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1}",
      "} catch ${2:e} {",
      "\t$0",
      "}"
    ],
    "description": "Create a try-catch block"
  },
  "Hinglish Try-Catch": {
    "prefix": "koshish",
    "body": [
      "koshish {",
