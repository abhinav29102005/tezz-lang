{
  "Service Block": {
    "prefix": "service",
    "body": [
      "service ${1:Name} on ${2:8080} {",
      "\t$0",
      "}"
    ],
    "description": "Create a new Tezz service"
  },
  "Hinglish Service Block": {
    "prefix": "seva",
    "body": [
      "seva ${1:Name} on ${2:8080} {",
      "\t$0",
      "}"
    ],
    "description": "Create a new Tezz service (Hinglish)"
  },
  "Route Block": {
    "prefix": "route",
    "body": [
      "route ${1|GET,POST,PUT,DELETE,PATCH,OPTIONS|} \"/${2:path}\" {",
      "\trespond ${3:200} { ${4:message}: \"${5:success}\" }",
      "}"
    ],
    "description": "Create a new HTTP route"
  },
  "Hinglish Route Block": {
    "prefix": "rasta",
    "body": [
      "rasta ${1|GET,POST,PUT,DELETE,PATCH,OPTIONS|} \"/${2:path}\" {",
      "\tjawab ${3:200} { ${4:message}: \"${5:success}\" }",
      "}"
    ],
    "description": "Create a new HTTP route (Hinglish)"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:functionName}(${2:params}) {",
      "\t${3:return $0}",
      "}"
    ],
    "description": "Create a function"
  },
  "Hinglish Function": {
    "prefix": "kaam",
    "body": [
      "kaam ${1:functionName}(${2:params}) {",
      "\t${3:vapas $0}",
      "}"
    ],
    "description": "Create a function (Hinglish)"
  },
  "Arrow Function": {
    "prefix": "arrow",
    "body": [
      "let ${1:name} = (${2:params}) => ${3:expression}"
    ],
    "description": "Create an arrow function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "\tconstructor(${2:params}) {",
      "\t\t${3:this.property = value}",
      "\t}",
      "\t",
      "\t${4:methodName}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Create a class"
  },
  "Hinglish Class": {
    "prefix": "dhancha",
    "body": [
      "dhancha ${1:ClassName} {",
      "\tconstructor(${2:params}) {",
      "\t\t${3:yeh.property = value}",
      "\t}",
      "\t",
      "\t${4:methodName}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Create a class (Hinglish)"
  },
  "Class with Extends": {
    "prefix": "classext",
    "body": [
      "class ${1:ClassName} extends ${2:BaseClass} {",
      "\tconstructor(${3:params}) {",
      "\t\t${4:this.property = value}",
      "\t}",
      "\t",
      "\t${5:methodName}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Create a class with inheritance"
  },
  "Hinglish Class with Extends": {
    "prefix": "dhanchase",
    "body": [
      "dhancha ${1:ClassName} se_bana ${2:BaseClass} {",
      "\tconstructor(${3:params}) {",
      "\t\t${4:yeh.property = value}",
      "\t}",
      "\t",
      "\t${5:methodName}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Create a class with inheritance (Hinglish)"
  },
  "Spawn Block": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t$0",
      "}"
    ],
    "description": "Create a parallel spawn block"
  },
  "Background Block": {
    "prefix": "background",
    "body": [
      "background {",
      "\t$0",
      "}"
    ],
    "description": "Create an asynchronous background task"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
