{
  "name": "tezz",
  "displayName": "Tezz Official",
  "description": "Premium syntax highlighting, snippets, and real-time LSP integration for the Tezz programming language.",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "tezz",
    "tezz-lang",
    "hinglish",
    "backend",
    "edge",
    "cloudflare",
    "workers",
    "api",
    "rest",
    "transpiler",
    "hindi",
    "language",
    "syntax"
  ],
  "publisher": "abhinav29102005",
  "contributes": {
    "languages": [
      {
        "id": "tezz",
        "aliases": [
          "Tezz",
          "tezz"
        ],
        "extensions": [
          ".tezz",
          ".tz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./logo.png",
          "dark": "./logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "tezz",
        "scopeName": "source.tezz",
        "path": "./syntaxes/tezz.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tezz",
        "path": "./snippets.json"
      }
    ]
  },
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinav29102005/tezz-lang.git"
  },
  "bugs": {
    "url": "https://github.com/abhinav29102005/tezz-lang/issues"
  },
  "homepage": "https://tezz.abhinavkumarsingh.tech",
  "main": "./client/out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd .."
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "author": "Abhinav",
  "license": "MIT"
}