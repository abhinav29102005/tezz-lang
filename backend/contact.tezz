import createClient from "tezz-database"

service on 8787 {
  GET "/" {
    return { status: "healthy", service: "Contact API" }
  }

  GET "/api/contacts" {
    let db = createClient({
      url: env.TURSO_URL,
      token: env.TURSO_TOKEN
    })

    try {
      let result = await db.execute("SELECT * FROM contacts ORDER BY id DESC LIMIT 50")
      return {
        success: true,
        contacts: result.rows
      }
    } catch err {
      return { success: false, error: "Database error" }
    }
  }

  POST "/api/contact" {
    let body = request.json()
    let name = body.name
    let email = body.email
    let message = body.message

    if !name || !email || !message {
      return { success: false, error: "Missing required fields" }
      return
    }

    let db = createClient({
      url: env.TURSO_URL,
      token: env.TURSO_TOKEN
    })

    try {
      let result = await db.execute("INSERT INTO contacts (name, email, message) VALUES (?, ?, ?)", [name, email, message])

      if result.ok {
        return { success: true }
      }
    } catch err {
      return { success: false, error: "Database error" }
    }
  }
}
