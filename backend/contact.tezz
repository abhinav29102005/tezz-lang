import createClient from "tezz-database"

service on 8787 {
  GET "/" {
    return { status: "healthy", service: "Contact API" }
  }

  GET "/api/contacts" {
    return { 
      success: true,
      contacts: [
        { name: "Abhinav", email: "abhinav@example.com", message: "Tezz is blazing fast!" },
        { name: "Batman", email: "batman@wayne.com", message: "We should use Tezz!" },
        { name: "Pikachu", email: "pika@chu.com", message: "Zero-overhead JS without node_modules" }
      ]
    }
  }

  POST "/api/contact" {
    let body = request.json()
    let name = body.name
    let email = body.email
    let message = body.message

    if !name || !email || !message {
      return { success: false, error: "Missing required fields" }
      return
    }

    let db = createClient({
      url: env.TURSO_URL,
      token: env.TURSO_TOKEN
    })

    try {
      let result = await db.execute("INSERT INTO contacts (name, email, message) VALUES (?, ?, ?)", [name, email, message])

      if result.ok {
        return { success: true }
      }
    } catch err {
      return { success: false, error: "Database error" }
    }
  }
}
