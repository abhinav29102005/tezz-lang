{
  "name": "tezz-lang",
  "version": "0.5.0",
  "description": "Tezz (तेज़) — A high-performance transpiled programming language for the edge (Cloudflare Workers, Node.js, Bun). Natively supports English and Hinglish syntax.",
  "main": "src/lexer.js",
  "bin": {
    "tezz": "./bin/tezz.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node bin/tezz.js build examples/hello.tezz --output /dev/null && echo 'Tests passed'",
    "example:hello": "node bin/tezz.js run examples/hello.tezz",
    "example:api": "node bin/tezz.js run examples/api.tezz",
    "prepublishOnly": "npm test",
    "build:binaries": "npx pkg . --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --out-path bin-dist/",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "keywords": [
    "tezz",
    "tezz-lang",
    "programming-language",
    "compiler",
    "transpiler",
    "interpreter",
    "ast",
    "backend",
    "edge-computing",
    "cloudflare-workers",
    "bun",
    "nodejs",
    "hinglish",
    "hindi",
    "esolang",
    "language-server",
    "http-server",
    "oop"
  ],
  "author": "Abhinav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinav29102005/tezz-lang.git"
  },
  "homepage": "https://github.com/abhinav29102005/tezz-lang#readme",
  "bugs": {
    "url": "https://github.com/abhinav29102005/tezz-lang/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  }
}
