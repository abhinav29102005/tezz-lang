{
  "name": "tezz-lang",
  "version": "0.4.8",
  "description": "Tezz (तेज़) — The Fast Backend Language. Write once, deploy everywhere: Cloudflare Workers, Node.js, Deno, Bun.",
  "main": "src/lexer.js",
  "bin": {
    "tezz": "./bin/tezz.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node bin/tezz.js build examples/hello.tezz --output /dev/null && echo 'Tests passed'",
    "example:hello": "node bin/tezz.js run examples/hello.tezz",
    "example:api": "node bin/tezz.js run examples/api.tezz",
    "prepublishOnly": "npm test",
    "build:binaries": "npx pkg . --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --out-path bin-dist/"
  },
  "keywords": [
    "tezz",
    "programming-language",
    "backend",
    "cloudflare-workers",
    "edge-computing",
    "compiler",
    "transpiler",
    "http-server",
    "api",
    "hinglish"
  ],
  "author": "Abhinav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinav29102005/automatic-octo-carnival.git"
  },
  "homepage": "https://github.com/abhinav29102005/automatic-octo-carnival#readme",
  "bugs": {
    "url": "https://github.com/abhinav29102005/automatic-octo-carnival/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "tezz-lang": "^0.3.1"
  }
}
