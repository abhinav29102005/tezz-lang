-- Tezz Comprehensive Test Suite
-- This file tests every single feature of the Tezz language compiler.

print("=== 1. Core Syntax & Data Types ===")
let a = 10
const b = 20
print("Math: ", (a + b) * 2 / 5)

let isAwesome = true
let isBoring = false
print("Logic: ", isAwesome && !isBoring)

let arr = [1, 2, 3, 4, 5]
print("Array index 2:", arr[2])

let obj = { 
  name: "Tezz", 
  version: 0.2,
  tags: ["fast", "hinglish"]
}
print("Object property:", obj.name)

print("=== 2. Control Flow & Loops ===")
if (a > b) {
  print("Math is broken!")
} else if (a == 10) {
  print("If/Else works!")
} else {
  print("Failed.")
}

print("While Loop:")
let counter = 0
while (counter < 3) {
  print(counter)
  counter = counter + 1
}

print("New Range Syntax (1..3):")
for i in 1..3 {
  print(i)
}

print("=== 3. Functions & Scope ===")
fn add(x, y) {
  return x + y
}
print("add(5, 7) =", add(5, 7))

let multiply = (x, y) => x * y
print("Arrow function multiply(4, 3) =", multiply(4, 3))

print("=== 4. Advanced Features ===")
try {
  let fake = nonExistentVariable
} catch e {
  print("Try/Catch works! Caught error.")
}

print("=== 5. Hinglish Mode ===")
rakho myVar = 42
agar (myVar == 42) {
  dikha("Hinglish IF works!")
} warna {
  dikha("Hinglish IF failed!")
}

jabtak (myVar < 45) {
  dikha(myVar)
  myVar = myVar + 1
}

print("=== All Tests Evaluated Successfully! ===")
